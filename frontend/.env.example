# Copy this file to .env and fill in your values.

# Leave empty if frontend and backend are on the same domain.
# Set to your backend's full URL if on a separate domain:
VITE_BACKEND_URL=

# Optional: enables the "Fill in demo account" button on the login page.
# Leave blank to hide it.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
