# Copy this file to .env and fill in your values.
# Generate JWT_SECRET with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

JWT_SECRET=<random-string-32-chars-minimum>
ADMIN_EMAIL=admin@clerifymed.app
ADMIN_PASSWORD=<secure-password>

# MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/medical_ai
MONGO_URI=mongodb://localhost:27017/medical_ai

# Your deployed frontend URL (used for CORS)
FRONTEND_URL=https://your-frontend-domain.com

# Comma-separated extra origins to allow (e.g. a preview URL)
CORS_EXTRA_ORIGINS=

# Set TRUST_PROXY_HEADERS=true only if deployed behind a load balancer / reverse proxy
# TRUST_PROXY_HEADERS=true
